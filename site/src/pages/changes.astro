---
import Base from "../layouts/Base.astro";
import changesJson from "../data/changes.json";
import talentsJson from "../data/talents.json";

interface Change { cls: string | null; tree: string; name: string; was?: string | null; kinds: string[]; classic: string; forever?: string; est?: boolean; classicRanks?: number; foreverRanks?: number }
const data = changesJson as { builds: { forever: string; classic: string }; talents: Change[]; stats: { items: number[]; newItemsByQuality: number[]; quests: number[]; spells: number[] }; epics: [number, string, number, number][] };
const classes = (talentsJson as { classes: { name: string; slug: string }[] }).classes;

const sure = (c: Change) => c.kinds.includes("reworked") || c.kinds.includes("renamed") || !c.est;
const confident = data.talents.filter(sure);
const unconfirmed = data.talents.filter((c) => !sure(c));
const byClass = classes.map((cl) => ({ ...cl, list: confident.filter((c) => c.cls === cl.name) })).filter((c) => c.list.length);
const kindLabel: Record<string, string> = { reworked: "Reworked", renamed: "Renamed", numbers: "New numbers", moved: "Moved", "moved tree": "New tree", ranks: "Ranks changed", removed: "Removed" };
const [itemsF, itemsC, itemsNew] = data.stats.items;
const [questsF, questsC, questsNew] = data.stats.quests;
const [spellsF, spellsC, spellsNew] = data.stats.spells;
const n = (v: number) => v.toLocaleString("en-US");
---
<Base title="Forever vs Classic changes" description={`What WoW Forever changed from Classic Era, read straight from both game clients: ${confident.length} talent changes, ${n(questsNew)} new quest IDs and ${n(itemsNew)} new items.`}>
  <h1>What Forever changed</h1>
  <p class="lede">Compared straight from the two game clients: WoW Forever build {data.builds.forever} against Classic Era build {data.builds.classic}.</p>

  <section class="facts" aria-label="Totals">
    <div><b>{confident.length}</b><span>talents with confirmed changes</span></div>
    <div><b>{n(questsNew)}</b><span>quest IDs that aren't in Classic Era</span></div>
    <div><b>{n(itemsNew)}</b><span>items that aren't in Classic Era</span></div>
    <div><b>{n(spellsNew)}</b><span>spells that aren't in Classic Era</span></div>
  </section>
  <p class="small muted">The Forever client has {n(questsF)} quest IDs, {n(itemsF)} items and {n(spellsF)} spells, against {n(questsC)}, {n(itemsC)} and {n(spellsC)} in Classic Era. Quest names and rewards live on the game servers, not in the client, so quests are counted here and filled in by ForeverScout logs.</p>

  <h2>Talents by class</h2>
  <nav class="jump" aria-label="Classes">
    {byClass.map((c) => <a href={`#${c.slug}`}>{c.name} <span class="muted">{c.list.length}</span></a>)}
  </nav>

  {byClass.map((cl) => (
    <section id={cl.slug} class="cls">
      <h3>{cl.name} <a class="small" href={`/talents/${cl.slug}/`}>Open the {cl.name} calculator</a></h3>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Talent</th><th>Change</th><th>Classic Era</th><th>Forever</th></tr></thead>
          <tbody>
            {cl.list.map((c) => (
              <tr>
                <td><b>{c.name}</b><br /><span class="muted small">{c.tree}{c.was ? `, was ${c.was}` : ""}</span></td>
                <td>{c.kinds.map((k) => <span class={`kind ${k.replace(" ", "-")}`}>{kindLabel[k] || k}</span>)}</td>
                <td class="txt">{c.classic}</td>
                <td class="txt">{c.forever}{c.est ? <span class="est"> Top-rank numbers estimated.</span> : null}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <details class="unconfirmed">
    <summary><b>{unconfirmed.length} possible number changes</b> <span class="muted">we can't confirm yet</span></summary>
    <p class="small muted">These talents read the same in both clients apart from the numbers, but Forever's client only stores rank 1's numbers for them. Some of these are real changes, some come from our rank estimates. Player logs and in-game checks will sort them out.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Class</th><th>Talent</th><th>Classic Era top rank</th><th>Forever, estimated top rank</th></tr></thead>
        <tbody>
          {unconfirmed.map((c) => (
            <tr><td>{c.cls}</td><td>{c.name}</td><td class="txt">{c.classic}</td><td class="txt muted">{c.forever}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>

  <h2>New epic gear</h2>
  <p class="muted">Equippable epics in the Forever client that Classic Era doesn't have, highest item level first. Where they drop isn't in the client.</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Item</th><th class="num">Item level</th><th class="num">Required level</th></tr></thead>
      <tbody>
        {data.epics.map(([id, name, ilvl, req]) => (
          <tr><td class="epic">{name}</td><td class="num">{ilvl}</td><td class="num">{req}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small muted">Data read from the game clients' tables via wago.tools. Spot something wrong? <a href="https://github.com/Jweyant/forever-xp/issues/new?template=bug.yml">Report it</a>.</p>
</Base>
<style>
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); border-top: 2px solid var(--ink); margin: 1.5rem 0 0.8rem; }
  .facts div { padding: 0.9rem 1rem 0.9rem 0; display: grid; gap: 0.1rem; }
  .facts b { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; color: var(--xp); }
  .facts span { color: var(--muted); font-size: var(--step--1); max-width: 22ch; }
  .jump { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin: 0.5rem 0 1rem; }
  .cls { scroll-margin-top: 1rem; }
  .cls h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1rem; }
  .cls h3 a { font-family: var(--font-body); font-weight: 400; }
  td.txt { min-width: 16rem; max-width: 34rem; }
  .kind { display: inline-block; font-size: 0.8rem; font-weight: 600; padding: 0.05em 0.45em; border-radius: 3px; margin: 0 0.25rem 0.25rem 0; white-space: nowrap; background: var(--xp-soft); color: var(--xp); }
  .kind.reworked { background: var(--skip-soft); color: var(--skip); }
  .kind.renamed { background: var(--do-soft); color: var(--do); }
  .est { color: var(--quest); font-size: 0.85rem; }
  .epic { color: var(--xp); font-weight: 600; }
  .unconfirmed { margin: 2rem 0 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 0.7rem 1rem; }
  .unconfirmed summary { cursor: pointer; }
  .unconfirmed .table-scroll { margin-top: 0.6rem; }
</style>
