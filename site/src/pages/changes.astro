---
import Base from "../layouts/Base.astro";
import ChangeList from "../components/ChangeList.astro";
import { qdb } from "../lib/questdb";
import { ICON } from "../config";
import { rows, notes, build, races, CLASSES as classes, slug, fmt } from "../lib/changes";

const areas = [...new Set(rows.map((r) => r.area))].sort((a, b) => a.localeCompare(b));
const dates = [...new Set(rows.map((r) => r.date).filter(Boolean))].sort().reverse();
const blizz = rows.filter((r) => r.kind === "Blizzard").length;
const issues = rows.filter((r) => r.kind === "Known issue").length;
const mined = rows.filter((r) => r.kind === "Datamined").length;
const newQuests = qdb.filter((q) => q.new).length;
const n = (v: number) => v.toLocaleString("en-US");
---
<Base image="/og/changes.jpg" title="Every WoW Forever change" description={`All ${n(rows.length)} WoW Forever changes in one searchable table: Blizzard's beta development notes, class and race updates, known issues, and talent changes read from the game client.`}>
  <h1>Every Forever change</h1>
  <p class="lede">Blizzard's development notes from the beta, split into single changes you can search and filter, plus what we read out of the game client. Updated within a few hours of each new post.</p>
  <p class="small">Blizzard's other announcements, like name reservation, realm and launch news, are on <a href="/news/">News from Blizzard</a>.</p>

  <section class="totals" aria-label="Totals">
    <a href="?src=Blizzard"><b>{n(blizz)}</b><span>changes from Blizzard's notes</span></a>
    <a href="?src=Datamined"><b>{n(mined)}</b><span>talent changes in the client</span></a>
    <a href="/quests/?new=1"><b>{n(newQuests)}</b><span>quests new in Forever</span></a>
    <a href="?src=Known%20issue"><b>{n(issues)}</b><span>known issues Blizzard listed</span></a>
  </section>

  <section id="chg" class="chg">
    <div class="filters">
      <label class="grow">Search<input type="search" id="c-q" placeholder="Spell, talent, quest, anything" autocomplete="off" /></label>
      <label>Source<select id="c-src"><option value="">All sources</option><option value="Blizzard">Blizzard's notes</option><option value="Datamined">Read from the client</option><option value="Known issue">Known issues</option></select></label>
      <label>Area<select id="c-area"><option value="">All areas</option>{areas.map((a) => <option value={a}>{a}</option>)}</select></label>
      <label>Race<select id="c-race"><option value="">Any race</option>{races.map((r) => <option value={r}>{r}</option>)}</select></label>
      <label>Posted<select id="c-date"><option value="">Any date</option>{dates.map((d) => <option value={d}>{fmt(d)}</option>)}</select></label>
      <label class="check"><input type="checkbox" id="c-dev" /> With developer notes</label>
    </div>
    <div class="clsbar" role="group" aria-label="Filter by class">
      {classes.map((c) => (
        <button type="button" data-cls={c} aria-pressed="false" title={c}><img src={ICON(`classicon_${c.toLowerCase()}`, 36)} alt="" width="26" height="26" loading="lazy" /><span>{c}</span></button>
      ))}
    </div>
    <p class="muted small" id="c-count" aria-live="polite">{n(rows.length)} changes</p>
    <p class="muted small hint">Pick a class and a race to see everything for that character: the class's changes plus the race's racial changes.</p>
    <p class="small pages">One page each, easy to share: {classes.map((c, i) => <>{i > 0 && " · "}<a href={`/changes/${slug(c)}/`}>{c}</a></>)} · <a href="/changes/racials/">Racials</a></p>

    <ChangeList rows={rows} build={build} id="c-rows" />
    <p class="empty muted" id="c-empty" hidden>No changes match. Clear a filter or two.</p>
  </section>

  <h2>Official sources</h2>
  <ul class="sources">
    {notes.sources.filter((s) => s.rows).map((s) => <li><a href={s.url} rel="noopener">{s.title}</a> <span class="muted small">{s.rows} entries, last post {fmt(s.updated)}</span></li>)}
    {notes.articles.map((a) => <li><a href={a.url} rel="noopener">{a.title}</a> <span class="muted small">Blizzard article</span></li>)}
  </ul>
  <p class="small muted">Notes are Blizzard's own words, collected from their staff posts on the official forums (last checked {notes.updated}); each row links to the post it came from. Talent changes are read from Forever client build {build}. Talents where the client only stores rank 1's numbers are left out until they can be confirmed.</p>
</Base>
<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLElement>("#c-rows > li")];
  const picked = new Set<string>();
  const ctl = { q: "c-q", src: "c-src", area: "c-area", race: "c-race", date: "c-date" } as const;
  function apply() {
    const q = $("c-q").value.trim().toLowerCase(), src = $("c-src").value, area = $("c-area").value, race = $("c-race").value, date = $("c-date").value, dev = $("c-dev").checked;
    let shown = 0;
    for (const r of rows) {
      const d = r.dataset;
      // Class and race describe one character: show that class's changes plus that race's
      // racial changes. A row tied to both (a Priest racial for Undead) needs both to match.
      const clsOk = !picked.size || (!!d.cls && picked.has(d.cls));
      const raceOk = !race || (!!d.race && d.race === race);
      const who = picked.size && race
        ? (d.cls && d.race ? clsOk && raceOk : d.cls ? clsOk : d.race ? raceOk : false)
        : picked.size ? clsOk : race ? raceOk : true;
      const ok = who && (!q || d.search!.includes(q)) && (!src || d.src === src) && (!area || d.area === area)
        && (!date || d.date === date) && (!dev || d.dev);
      r.hidden = !ok; if (ok) shown++;
    }
    document.getElementById("c-count")!.textContent = `${shown.toLocaleString("en-US")} of ${rows.length.toLocaleString("en-US")} changes`;
    document.getElementById("c-empty")!.hidden = shown > 0;
    const p = new URLSearchParams();
    for (const [k, id] of Object.entries(ctl)) { const v = $(id).value.trim(); if (v) p.set(k, v); }
    if (dev) p.set("dev", "1");
    if (picked.size) p.set("cls", [...picked].join("."));
    history.replaceState(null, "", p.toString() ? `?${p}` : location.pathname);
  }
  const p = new URLSearchParams(location.search);
  for (const [k, id] of Object.entries(ctl)) { const v = p.get(k); if (v) $(id).value = v; }
  $("c-dev").checked = p.get("dev") === "1";
  (p.get("cls") || "").split(".").filter(Boolean).forEach((c) => picked.add(c));
  document.querySelectorAll<HTMLButtonElement>("[data-cls]").forEach((b) => {
    if (b.closest("#c-rows")) return;
    b.setAttribute("aria-pressed", String(picked.has(b.dataset.cls!)));
    b.addEventListener("click", () => {
      const c = b.dataset.cls!;
      if (picked.has(c)) picked.delete(c); else picked.add(c);
      b.setAttribute("aria-pressed", String(picked.has(c)));
      apply();
    });
  });
  let t = 0;
  [...Object.values(ctl), "c-dev"].forEach((id) => $(id).addEventListener("input", () => { clearTimeout(t); t = window.setTimeout(apply, 90); }));
  apply();
</script>
<style>
  .totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0; border-top: 2px solid var(--ink); margin: 1.4rem 0 0.6rem; }
  .totals a { display: grid; gap: 0.1rem; padding: 0.9rem 1rem 0.9rem 0; text-decoration: none; color: var(--ink); }
  .totals b { font: 700 var(--step-3)/1 var(--font-display); color: var(--xp); }
  .totals span { color: var(--muted); font-size: var(--step--1); }
  .totals a:hover b { text-decoration: underline; text-decoration-thickness: 2px; }
  .filters .grow { flex: 1 1 240px; }
  .filters .check { display: flex; gap: 0.4rem; align-items: center; color: var(--ink); font-size: 0.95rem; padding-bottom: 0.45rem; }
  .filters .check input { accent-color: var(--xp); }
  .clsbar { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.2rem 0 0.8rem; }
  .clsbar button { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.15rem 0.6rem 0.15rem 0.15rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: 600 0.92rem var(--font-display); cursor: pointer; }
  .clsbar img { border-radius: 50%; }
  .hint { margin: -0.4rem 0 0.8rem; }
  .clsbar button[aria-pressed="true"] { border-color: var(--xp); background: var(--xp-soft); }
  @media (max-width: 560px) { .clsbar span { display: none; } .clsbar button { padding: 0.15rem; } }
  .pages { margin: -0.4rem 0 0.9rem; }
  .sources { padding-left: 1.1rem; }
</style>
