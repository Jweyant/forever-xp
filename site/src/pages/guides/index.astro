---
import Base from "../../layouts/Base.astro";
import XpBar from "../../components/XpBar.astro";
import { guides, fmtMinutes, type Guide } from "../../lib/data";

// Each faction has several starting tracks (one per race) that join shared routes later.
// Group the guides by who they're for, in the order a player meets them.
const RACE_NAME: Record<string, string> = {
  "Orc/Troll": "Orc and Troll", Undead: "Undead", Tauren: "Tauren", Skyborne: "Skyborne",
  Human: "Human", "Dwarf/Gnome": "Dwarf and Gnome", NightElf: "Night Elf",
  "Human/Dwarf/Gnome": "Human, Dwarf and Gnome", Horde: "Every Horde race", Alliance: "Every Alliance race",
};
const ORDER = ["Orc/Troll", "Undead", "Tauren", "Human", "Dwarf/Gnome", "NightElf", "Skyborne", "Human/Dwarf/Gnome", "Horde", "Alliance"];
function tracks(faction: string) {
  const list = guides.filter((g) => g.faction === faction);
  const keys = [...new Set(list.map((g) => g.for || faction))];
  keys.sort((a, b) => (ORDER.indexOf(a) + 1 || 99) - (ORDER.indexOf(b) + 1 || 99));
  return keys.map((k) => ({
    name: RACE_NAME[k] || k,
    list: list.filter((g) => (g.for || faction) === k).sort((a, b) => (a.from ?? 0) - (b.from ?? 0)),
  }));
}
const factions = [
  { name: "Horde", cap: 30, tracks: tracks("Horde"), main: ["Orc/Troll", "Horde"],
    intro: "Every Horde starting zone, then one shared route through the Barrens, Stonetalon, Ashenvale, Hillsbrad and Thousand Needles to level 30. Orcs and Trolls start in Durotar, Undead in Tirisfal Glades, Tauren in Mulgore and Skyborne on Zephras Isle; all of them meet at the Crossroads around level 12." },
  { name: "Alliance", cap: 20, tracks: tracks("Alliance"), main: ["Human", "Human/Dwarf/Gnome", "Alliance"],
    intro: "Every Alliance starting zone, then each race's own 10–14 zone (Westfall, Loch Modan or Darkshore), Redridge or Darkshore to 17, and a shared Loch Modan finish at 20 by the Wetlands road. Skyborne start on Zephras Isle and join the Human route in Westfall." },
];
const mainLine = (f: { name: string; main: string[] }) => guides.filter((g) => g.faction === f.name && f.main.includes(g.for || f.name));
---
<Base image="/og/guides.jpg" title="Leveling guides" description="Free WoW Forever leveling guides for every Horde and Alliance race, with estimated time and XP for every step.">
  <h1>Leveling guides</h1>
  <p class="lede">Routes for every race, written for the RestedXP Guides addon. Each one shows its estimated time, where it ends and every step, and picks up Forever's new quests on the way.</p>

  {factions.map((f) => (
    <section>
      <h2>{f.name}</h2>
      <XpBar guides={mainLine(f)} faction={f.name} cap={f.cap} />
      <p>{f.intro}</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Levels</th><th>Zone</th><th>For</th><th class="num">Est. time</th><th class="num">Ends at</th><th class="num">Quests</th><th>Checks</th></tr></thead>
          {f.tracks.map((t) => (
            <tbody>
              {t.list.map((g: Guide) => (
                <tr>
                  <td><b>{g.from}–{g.to}</b></td>
                  <td><a href={`/guides/${g.slug}/`}>{g.zone}</a></td>
                  <td>{t.name}</td>
                  <td class="num">{fmtMinutes(g.minutes)}</td>
                  <td class="num">{g.end_level?.toFixed(1) ?? "–"}</td>
                  <td class="num">{g.quest_ids.length}</td>
                  <td>{g.issues?.length ? <span class="verdict skip">{g.issues.length} to check</span> : <span class="verdict do">Clean</span>}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </section>
  ))}

  <h2>Install the guides</h2>
  <ol>
    <li>Install the free <b>RestedXP Guides</b> addon.</li>
    <li>Copy the <code>ForeverXP_Guides</code> folder from the <a href="https://github.com/Jweyant/forever-xp/tree/main/guides/ForeverXP_Guides">repository</a> into <code>Interface\AddOns\</code>.</li>
    <li>In game, open the RestedXP guide list and pick the <b>ForeverXP Horde</b> or <b>ForeverXP Alliance</b> group.</li>
  </ol>
  <p class="muted small">Forever's new quests don't have XP numbers in any open data yet, so the estimates use the usual XP for a quest of the same level and kind. "Ends at" can be off by a level either way until ForeverScout logs measure the real numbers. <a href="/contribute/">Help with a log</a></p>
</Base>
