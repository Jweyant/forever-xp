---
// Blizzard's WoW Forever announcements (name reservation, realms, launch news, articles), apart
// from the game changes on /changes/. Titles and excerpts are Blizzard's text, shown escaped.
import Base from "../layouts/Base.astro";
import { news, fmt } from "../lib/changes";

const n = (v: number) => v.toLocaleString("en-US");
const months = [...new Set(news.map((a) => a.date.slice(0, 7)))];
const monthName = (m: string) => new Date(`${m}-15T12:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric" });
---
<Base image="/og/news.jpg" title="News from Blizzard" description={`Every WoW Forever announcement from Blizzard in one place: name reservation, realms, launch news, articles and podcasts, newest first, each linked to Blizzard's post.`}>
  <h1>News from Blizzard</h1>
  <p class="lede">Every WoW Forever announcement Blizzard has posted on the official forums, newest first: name reservation, realms, launch news, articles and podcasts. Each links to Blizzard's post. Checked every hour.</p>
  <p class="small">Looking for class, race and talent changes? They're on <a href="/changes/">Every Forever change</a>.</p>

  {news.length === 0 ? (
    <p class="muted">No announcements collected yet. They'll appear here within the hour after Blizzard posts one.</p>
  ) : (
    <>
      <p class="muted small">{n(news.length)} announcements{news[0] && `, latest ${fmt(news[0].date)}`}.</p>
      {months.map((m) => (
        <section>
          <h2>{monthName(m)}</h2>
          <ol class="news">
            {news.filter((a) => a.date.startsWith(m)).map((a) => (
              <li>
                <div class="meta">
                  <span class={a.kind === "Article" ? "tag art" : a.notes ? "tag notes" : "tag post"}>{a.kind === "Article" ? "Article" : a.notes ? "Change notes" : "Forum post"}</span>
                  <time datetime={a.date}>{fmt(a.date)}</time>
                </div>
                <div class="body">
                  <p class="where">{a.category}</p>
                  <h3><a href={a.url} rel="noopener">{a.title}</a></h3>
                  {a.excerpt && <p class="ex">{a.excerpt}</p>}
                  {a.notes && <p class="small"><a href={`/changes/?date=${a.date}`}>See the changes from this post</a></p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </>
  )}
  <p class="small muted foot">Collected from topics Blizzard staff started in the WoW Forever sections of the official forums, including the news articles Blizzard posts there. Text is Blizzard's; open a post for the full announcement.</p>
</Base>
<style>
  .news { list-style: none; padding: 0; margin: 0 0 1rem; max-width: none; border-top: 2px solid var(--ink); }
  .news > li { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0.3rem 1rem; padding: 0.8rem 0.2rem; border-bottom: 1px solid var(--line); }
  .body { min-width: 0; overflow-wrap: anywhere; }
  .meta { display: grid; align-content: start; gap: 0.25rem; font-size: 0.85rem; color: var(--muted); }
  .tag { justify-self: start; font: 600 0.72rem/1 var(--font-body); padding: 0.25em 0.5em; border-radius: 3px; }
  .tag.post { background: #0f4c9c; color: #fff; } .tag.art { background: var(--quest-bright); color: #1a1405; } .tag.notes { background: var(--xp-soft); color: var(--xp); }
  .body p { margin: 0; max-width: 80ch; }
  .where { font-size: 0.85rem; color: var(--muted); }
  .body h3 { margin: 0.1rem 0 0.2rem; font-size: var(--step-1); }
  .ex { color: var(--muted); }
  .foot { margin-top: 1.4rem; }
  @media (max-width: 640px) {
    .news > li { grid-template-columns: minmax(0, 1fr); }
    .meta { display: flex; gap: 0.6rem; align-items: center; }
  }
</style>
