---
import Base from "../../layouts/Base.astro";
import { questById, guideBySlug, VERDICT_LABEL, rateOf, meta, SUBMIT_LOG, type Quest } from "../../lib/data";
import { qdb, qById, zslug, QUALITY, ICON, SIDE_LABEL, type QQuest, type Place } from "../../lib/questdb";

export function getStaticPaths() {
  return qdb.map((q) => ({ params: { id: String(q.id) }, props: { q } }));
}
const { q } = Astro.props as { q: QQuest };
const s: Quest | undefined = questById.get(q.id);
const rate = s ? rateOf(s) : null;
const name = (id: number) => qById.get(id)?.n ?? `Quest ${id}`;
const pre = (q.pre || []).filter((id) => id > 0);
// Walk the chain backwards and forwards so the page shows where this quest sits.
const back: number[] = [];
for (let cur = pre[0], guard = 0; cur && guard < 12; guard++) { back.unshift(cur); cur = (qById.get(cur)?.pre || [])[0]; }
const fwd: number[] = [];
for (let cur = q.next, guard = 0; cur && guard < 12; guard++) { fwd.push(cur); cur = qById.get(cur)?.next; }
const chain = back.length || fwd.length ? [...back, q.id, ...fwd] : [];
const why = !s ? null :
  s.verdict === "do" ? "Part of a Forever XP route." :
  s.verdict === "skip" ? (s.skip_note?.reason ? `Skipped in the route: ${s.skip_note.reason}.` : `Below ${meta.skip_threshold} XP per minute once travel is counted.`) :
  s.verdict === "unknown" ? "Some objectives have no known location yet, so it can't be scored." :
  "Worth doing if you're nearby, but it isn't in a route.";
const desc = `${q.n}${q.lv ? ` (level ${q.lv})` : ""}, a WoW Forever quest in ${q.z}${q.start ? `. Starts with ${q.start.n}` : ""}${q.xp ? `, ${q.xp} XP` : ""}.`;
const places = [q.start && { role: "Start", p: q.start }, q.end && { role: "Turn in", p: q.end }].filter(Boolean) as { role: string; p: Place }[];
const kind = (t: string) => (t === "object" ? "Object" : t === "item" ? "Item" : "NPC");
---
<Base title={`${q.n} quest`} description={desc}>
  <p class="crumbs"><a href="/quests/">Quests</a> / <a href={`/quests/zone/${zslug(q.z)}/`}>{q.z}</a></p>
  <h1>{q.n}</h1>
  <p class="tags">
    {q.side ? <span class={`tag side-${q.side}`}>{SIDE_LABEL[q.side]}</span> : <span class="tag">Both factions</span>}
    {q.cls?.map((c) => <span class="tag cls"><img src={ICON(`classicon_${c.toLowerCase()}`)} alt="" width="18" height="18" loading="lazy" />{c}</span>)}
    {q.rep && <span class="tag">Repeatable</span>}
    {s && <span class={`verdict ${s.verdict}`}>{VERDICT_LABEL[s.verdict]}</span>}
  </p>
  {why && <p class="lede">{why}</p>}

  <dl class="facts">
    <div><dt>Quest level</dt><dd>{q.lv > 0 ? q.lv : "–"}</dd></div>
    <div><dt>Required level</dt><dd>{q.req || "–"}</dd></div>
    <div><dt>Quest XP</dt><dd>{s?.xp ?? q.xp ?? "–"}</dd></div>
    {s && <div><dt>Estimated minutes</dt><dd>{s.minutes ?? "–"}</dd></div>}
    {s && <div><dt>XP per minute</dt><dd>{s.unlocated || rate == null ? "–" : rate}</dd></div>}
    {q.repu ? <div><dt>Reputation rewards</dt><dd>{q.repu}</dd></div> : null}
  </dl>

  {q.obj && (<>
    <h2>Objectives</h2>
    <p class="obj">{q.obj}</p>
  </>)}

  {places.length > 0 && (<>
    <h2>Where to go</h2>
    <div class="where">
      {places.map(({ role, p }) => (
        <figure class="pin">
          <div class="grid" aria-hidden="true">
            {p.x != null && <span class={`dot ${role === "Start" ? "start" : "end"}`} style={`left:${p.x}%;top:${p.y}%`}></span>}
          </div>
          <figcaption>
            <span class="role">{role}</span>
            <b>{p.n}</b>
            <span class="muted">{kind(p.t)}{p.z ? `, ${p.z}` : ""}{p.x != null ? ` at ${p.x}, ${p.y}` : ""}</span>
            {p.x != null && <code class="way">/way {p.x} {p.y} {p.n}</code>}
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="small muted">The square stands in for the zone map: the marker sits at the in-game map coordinates. The <code>/way</code> line works with TomTom.</p>
  </>)}

  {q.rew && q.rew.length > 0 && (<>
    <h2>Rewards</h2>
    <ul class="rewards">
      {q.rew.map((r) => (
        <li>
          <span class={`pic q-b-${QUALITY[r.q ?? 1]}`}>{r.icon && <img src={ICON(r.icon)} alt="" width="36" height="36" loading="lazy" />}</span>
          <span class={`q-${QUALITY[r.q ?? 1]}`}>{r.n}</span>
          <span class="muted small">Item {r.id}</span>
        </li>
      ))}
    </ul>
    {q.rew.length > 1 && <p class="small muted">Quest rewards are usually a choice of one. Check them against your plan in the <a href="/bis/">BIS planner</a>.</p>}
  </>)}

  {chain.length > 1 && (<>
    <h2>Quest chain</h2>
    <ol class="chain">
      {chain.map((id) => <li class={id === q.id ? "here" : ""}>{id === q.id ? <b>{name(id)}</b> : qById.has(id) ? <a href={`/quests/${id}/`}>{name(id)}</a> : name(id)}</li>)}
    </ol>
  </>)}
  {pre.length > 1 && <p>Also needs: {pre.slice(1).map((id, i) => <>{i ? ", " : ""}{qById.has(id) ? <a href={`/quests/${id}/`}>{name(id)}</a> : name(id)}</>)}.</p>}

  {s && s.guides.length > 0 && (<>
    <h2>In the routes</h2>
    <ul>{s.guides.map((g) => { const gd = guideBySlug.get(g); return gd ? <li><a href={`/guides/${g}/`}>{gd.name}</a></li> : null; })}</ul>
  </>)}

  <div class="callout">
    {s?.measured
      ? <p>Measured from {s.measured.players} player logs: median {s.measured.minutes} minutes.</p>
      : <p>No player has logged this quest yet. If you do it with <a href="/scout/">ForeverScout</a> running, your time helps score it. <a href={SUBMIT_LOG}>Send a log</a></p>}
  </div>
  <p class="small muted">Quest ID {q.id}. Quest data from <a href="https://github.com/Questie/Questie">Questie</a>'s Forever database (GPLv3).</p>
</Base>
<style>
  .crumbs { color: var(--muted); font-size: var(--step--1); margin-bottom: 0.3rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin: 0.4rem 0 0.8rem; }
  .tag { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.85rem; font-weight: 600; padding: 0.1em 0.6em; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); }
  .tag img { border-radius: 50%; }
  .side-H { border-color: #b3261e; color: #b3261e; } .side-A { border-color: #2f6fd0; color: #2f6fd0; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.5rem 1.5rem; border-top: 2px solid var(--ink); padding-top: 0.8rem; margin: 1.2rem 0; }
  .facts dt { color: var(--muted); font-size: var(--step--1); }
  .facts dd { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: var(--step-2); }
  .obj { border-left: 4px solid var(--quest-bright); padding: 0.4rem 0.9rem; background: var(--surface); border-radius: 0 var(--radius) var(--radius) 0; }
  .where { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  .pin { margin: 0; display: grid; grid-template-columns: 110px 1fr; gap: 0.8rem; align-items: start; }
  .pin .grid { position: relative; width: 110px; height: 110px; border-radius: 6px; border: 2px solid #8a6d3b;
    background: linear-gradient(#0000 calc(25% - 1px), #8a6d3b33 0 25%, #0000 0) 0 0 / 100% 25%, linear-gradient(90deg, #0000 calc(25% - 1px), #8a6d3b33 0 25%, #0000 0) 0 0 / 25% 100%, radial-gradient(circle at 40% 40%, #3b4a36, #1f2a20); }
  .pin .dot { position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; border: 2px solid #111; box-shadow: 0 0 0 3px #0006, 0 0 10px #e8b92e; }
  .pin .dot.start { background: #e8b92e; } .pin .dot.end { background: #69ccf0; }
  .pin figcaption { display: grid; gap: 0.1rem; }
  .pin .role { font: 600 0.75rem var(--font-display); text-transform: uppercase; letter-spacing: 0.08em; color: var(--xp); }
  .pin .way { font-size: 0.8rem; margin-top: 0.3rem; word-break: break-word; }
  .rewards { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .rewards li { display: grid; grid-template-columns: 40px 1fr auto; gap: 0.6rem; align-items: center; }
  .pic { width: 38px; height: 38px; border-radius: 4px; overflow: hidden; background: #10161d; border: 2px solid var(--qb, #555); }
  .pic img { display: block; width: 100%; height: 100%; }
  .q-b-poor { --qb: #9d9d9d; } .q-b-common { --qb: #bbb; } .q-b-uncommon { --qb: #1eaa1e; } .q-b-rare { --qb: #0070dd; } .q-b-epic { --qb: #a335ee; } .q-b-legendary { --qb: #ff8000; }
  .q-poor { color: #9d9d9d; } .q-uncommon { color: #1eaa1e; } .q-rare { color: #2b6fd6; } .q-epic { color: #9f45e6; } .q-legendary { color: #e07b00; }
  .chain { padding-left: 1.4rem; } .chain .here { color: var(--xp); }
</style>
