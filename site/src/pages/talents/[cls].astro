---
import { jsonForHtml } from "../../scripts/items";
import Base from "../../layouts/Base.astro";
import { CLASS_COLOR } from "../../config";
import talentsJson from "../../data/talents.json";
import buildsJson from "../../data/talent-builds.json";
import playersJson from "../../data/player-talents.json";

const data = talentsJson as { build: string; hotfixes?: boolean; classes: { id: number; name: string; slug: string; trees: { name: string; talents: unknown[] }[] }[] };
export function getStaticPaths() {
  return (talentsJson as typeof data).classes.map((c) => ({ params: { cls: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: (typeof data.classes)[number] };
const treeNames = c.trees.map((t) => t.name).join(", ");
// Recommended and popular builds for this class. Build strings are validated here and the digits
// are clamped to each talent's rank cap by the calculator when a link loads one.
const BUILD_RE = /^[0-5]{0,30}(-[0-5]{0,30}){0,2}$/;
const okBuild = (b: unknown): b is { n: string; t: string; note?: string; spec?: string } =>
  !!b && typeof b === "object" && typeof (b as { n: unknown }).n === "string" && typeof (b as { t: unknown }).t === "string"
  && BUILD_RE.test((b as { t: string }).t) && (b as { t: string }).t.replace(/-/g, "").length > 0;
const groups = (buildsJson as { classes: Record<string, Record<string, unknown[]>> }).classes?.[c.slug] ?? {};
const oursBuilds = (Array.isArray(groups.ours) ? groups.ours : []).filter(okBuild);
const wowsimsBuilds = (Array.isArray(groups.wowsims) ? groups.wowsims : []).filter(okBuild);
// What players actually run, from ForeverScout logs: every build, most used first (aggregates
// only; a build is listed once two or more characters use it, so nobody's shows alone).
type PlayerGroups = { players?: number; groups?: Record<string, { n?: number; builds?: unknown }> };
const pl = (playersJson as Record<string, PlayerGroups>)[c.slug];
const plRows = (v: unknown): [string, number][] => (Array.isArray(v) ? v : [])
  .filter((r): r is [string, number] => Array.isArray(r) && typeof r[0] === "string" && BUILD_RE.test(r[0]) && Number(r[1]) > 0)
  .map((r) => [r[0], Math.floor(Number(r[1]))]);
const popular = ([
  ["all", "Everyone", "every character that shared logs"],
  ["pve", "PvE — dungeon and raid players", "characters that fought dungeon or raid bosses"],
  ["pvp", "PvP — battleground players", "characters that entered a battleground"],
] as const).map(([key, name, note]) => {
  const g = pl?.groups?.[key];
  return { name, note, n: Math.max(0, Math.floor(Number(g?.n) || 0)), rows: plRows(g?.builds) };
}).filter((g) => g.rows.length > 0);
// "0 / 31 / 20" from a build string, so each row names its spec without loading it.
const split = (b: string) => { const p = b.split("-"); return c.trees.map((_, i) => [...(p[i] || "")].reduce((s, d) => s + +d, 0)).join(" / "); };
const dominant = (b: string) => { const s = split(b).split(" / ").map(Number); const m = Math.max(...s); return m > 0 ? c.trees[s.indexOf(m)].name : ""; };
const hasBuilds = popular.length > 0 || oursBuilds.length > 0 || wowsimsBuilds.length > 0;
const ogImage = Object.prototype.hasOwnProperty.call(CLASS_COLOR, c.slug) ? `/og/talents-${c.slug}.jpg` : "/og/talents.jpg";
---
<Base image={ogImage} title={`${c.name} talent calculator`} description={`WoW Forever ${c.name} talent calculator: ${treeNames}. Built from the Forever game client, with shareable build links.`}>
  <p class="crumbs"><a href="/talents/">Talents</a> / {c.name}</p>
  <h1>{c.name} talents</h1>
  <nav class="classes" aria-label="Other classes">
    {data.classes.map((o) => <a href={`/talents/${o.slug}/`} aria-current={o.slug === c.slug ? "page" : undefined}>{o.name}</a>)}
  </nav>
  <p class="small"><a href={`/changes/${c.slug}/`}>Every {c.name} change in Forever</a></p>

  <div id="calc">
    <div class="bar">
      <dl class="stats">
        <div><dt>Points left</dt><dd class="big" data-left>51</dd></div>
        <div><dt>{c.trees.map((t) => t.name).join(" / ")}</dt><dd data-split>0 / 0 / 0</dd></div>
        <div><dt>Needs level</dt><dd data-level>–</dd></div>
      </dl>
      <div class="actions">
        <button type="button" class="btn" data-copy>Copy build link</button>
        <button type="button" class="btn secondary" data-reset>Reset</button>
      </div>
      <label class="share small muted">Build link <input data-share readonly /></label>
      <div class="save-plan" data-save-plan="talents" hidden>
        <form><label class="sr" for="save-name">Name</label><input id="save-name" maxlength="60" placeholder="Name this build" autocomplete="off" /><button type="submit" class="btn secondary">Save to my account</button></form>
        <a class="small" data-save-signin hidden>Sign in with Discord to save this build</a>
      </div>
    </div>
    <div class="layout">
      <div class="trees" data-trees></div>
      <aside class="detail" data-detail aria-live="polite"></aside>
    </div>
  </div>
  {hasBuilds && (<section id="builds">
    <h2>Builds for {c.name}</h2>
    <p class="small muted">Click a build to load it into the calculator above, then change whatever you like.</p>

    {popular.length > 0 && (<>
      <h3>Popular with players</h3>
      <p class="small muted">What {c.name}s running <a href="/scout/">ForeverScout</a> actually play. A build is listed once two or more characters use it; counts are characters, not accounts.</p>
      {popular.map((g) => (
        <div class="bgroup">
          <h4>{g.name} <span class="muted small">({g.note}{g.n > 0 ? `, ${g.n} in all` : ""})</span></h4>
          <ul class="builds">
            {g.rows.map(([b, n]) => (
              <li><a class="load" href={`#${b}`}><b>{dominant(b) || "Build"}</b> <span class="split">{split(b)}</span></a><span class="muted small">{n} character{n === 1 ? "" : "s"}{g.n > 1 ? ` · ${Math.round((n / g.n) * 100)}%` : ""}</span></li>
            ))}
          </ul>
        </div>
      ))}
      <p class="small muted">No open data source publishes Forever PvP builds yet, so the PvP list is measured from battleground players' own logs rather than copied from a guide.</p>
    </>)}
    {popular.length === 0 && <><h3>Popular with players</h3><p class="muted small">No {c.name} builds logged yet. Run <a href="/scout/">ForeverScout</a> while you play and every build players actually use shows up here — most used first, split into everyone, PvE (dungeon and raid) and PvP (battleground) players. No open data source publishes Forever PvP builds, so this is where the PvP picture will come from.</p></>}

    {oursBuilds.length > 0 && (<>
      <h3>From our sim runs <span class="muted small">(PvE)</span></h3>
      <p class="small muted">The builds our own <a href="/bis/">stat-weight simulations</a> run: measured, not guessed.</p>
      <ul class="builds">
        {oursBuilds.map((b) => (
          <li><a class="load" href={`#${b.t}`}><b>{b.n}</b> <span class="split">{split(b.t)}</span></a>{b.note && <span class="muted small">{b.note}</span>}</li>
        ))}
      </ul>
    </>)}

    {wowsimsBuilds.length > 0 && (<>
      <h3>wowsims presets <span class="muted small">(PvE)</span></h3>
      <p class="small muted">The preset builds from <a href="https://github.com/wowsims/forever" rel="noopener">wowsims/forever</a> (MIT), the open-source Forever simulator, read from the same pinned version our sims run on.</p>
      <ul class="builds">
        {wowsimsBuilds.map((b) => (
          <li><a class="load" href={`#${b.t}`}><b>{b.n}</b> <span class="split">{split(b.t)}</span></a>{b.spec && <span class="muted small">{b.spec}</span>}</li>
        ))}
      </ul>
    </>)}
  </section>)}

  <p class="small muted">Read from the WoW Forever game client's talent trees (build {data.build}){data.hotfixes ? " with Blizzard's latest hotfixes" : ""}, refreshed daily. Talents tagged NEW aren't in Classic Era. Click or tap to add a point, right-click or long-press to remove.</p>
  <script type="application/json" id="talent-data" set:html={jsonForHtml(c)} />
</Base>
<script>import "../../scripts/talents.ts"; import { mountSave } from "../../scripts/saveplan"; mountSave();</script>

<style is:global>
  .crumbs { color: var(--muted); font-size: var(--step--1); margin-bottom: 0.3rem; }
  .classes { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-bottom: 1.2rem; }
  .classes a[aria-current] { font-weight: 600; color: var(--ink); text-decoration-color: var(--xp); text-decoration-thickness: 2px; }
  #calc .bar { display: grid; gap: 0.6rem; border-top: 2px solid var(--ink); padding-top: 0.8rem; margin-bottom: 1rem; }
  @media (min-width: 900px) { #calc .bar { grid-template-columns: 1fr auto; align-items: center; } #calc .share { grid-column: 1 / -1; } }
  #calc .stats { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; margin: 0; }
  #calc .stats dt { color: var(--muted); font-size: var(--step--1); }
  #calc .stats dd { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: var(--step-2); line-height: 1.1; }
  #calc .stats dd.big { color: var(--xp); }
  #calc .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  #calc .share { display: grid; gap: 0.2rem; }
  .save-plan form { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .save-plan input { font: inherit; flex: 1; min-width: 12ch; background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.35rem 0.5rem; }
  .save-plan[hidden], .save-plan [hidden] { display: none; }
  #calc .save-plan { grid-column: 1 / -1; }
  #calc .share input { font: inherit; font-size: 0.85rem; width: 100%; background: var(--surface); color: var(--muted); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.35rem 0.5rem; }
  #calc .layout { display: grid; gap: 1.2rem; }
  @media (min-width: 1000px) { #calc .layout { grid-template-columns: 1fr 300px; align-items: start; } #calc .detail { position: sticky; top: 1rem; } }
  #calc .trees { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  #calc .tree { position: relative; isolation: isolate; overflow: hidden; background: #0d1018; color: #e6e8f0; border: 1px solid #2c3249; border-radius: var(--radius); padding: 0.6rem 0.7rem 0.9rem; }
  /* the tree's own icon, blown up and darkened, stands in for the game's painted tree backgrounds */
  #calc .tree::before { content: ""; position: absolute; inset: -20%; z-index: -1; background: var(--tree-bg, none) center / cover no-repeat; filter: blur(28px) saturate(1.2); opacity: 0.32; }
  #calc .tree::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(13,16,24,.15), rgba(13,16,24,.75)); }
  #calc .tree h2 { font-size: var(--step-1); margin: 0 0 0.7rem; display: flex; align-items: center; gap: 0.5rem; color: #f1e6c8; }
  #calc .tree h2 .ti { width: 28px; height: 28px; border-radius: 4px; border: 1px solid #8a6d3b; }
  #calc .tree h2 .tn { flex: 1; }
  #calc .tree h2 [data-spent] { color: var(--quest-bright); font-variant-numeric: tabular-nums; }
  #calc .grid { display: grid; grid-template-columns: repeat(4, 48px); gap: 14px 6px; justify-content: space-between; }
  #calc .tal { z-index: 1; }
  #calc .tal .new { position: absolute; left: -5px; top: -7px; font-style: normal; font-size: 0.6rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; line-height: 1; padding: 2px 3px; border-radius: 3px; background: var(--quest-bright); color: #1a1405; }
  #calc .detail .new-note { color: var(--quest); font-weight: 600; }
  /* prerequisite arrows, grey until the earlier talent is learned, then gold like in the game */
  #calc .arr { position: relative; z-index: 0; pointer-events: none; --c: #565c72; }
  #calc .arr[data-on] { --c: #e8b92e; }
  #calc .arr i { position: absolute; display: block; }
  #calc .arr .ln, #calc .arr .ln2 { background: var(--c); border-radius: 1px; }
  #calc .arr .hd { width: 0; height: 0; }
  #calc .arr.v .ln { left: calc(50% - 2px); width: 4px; top: 48px; bottom: 55px; }
  #calc .arr.v .hd { left: calc(50% - 6px); bottom: 48px; border: 6px solid transparent; border-bottom: 0; border-top: 7px solid var(--c); }
  #calc .arr.h .ln { top: calc(50% - 2px); height: 4px; left: 48px; right: 55px; }
  #calc .arr.h .hd { top: calc(50% - 6px); right: 48px; border: 6px solid transparent; border-right: 0; border-left: 7px solid var(--c); }
  #calc .arr.h[data-dir="l"] .ln { left: 55px; right: 48px; }
  #calc .arr.h[data-dir="l"] .hd { right: auto; left: 48px; border: 6px solid transparent; border-left: 0; border-right: 7px solid var(--c); }
  #calc .arr.e .ln { top: 22px; height: 4px; left: 48px; right: 22px; }
  #calc .arr.e .ln2 { top: 22px; width: 4px; right: 22px; bottom: 55px; }
  #calc .arr.e .hd { right: 18px; bottom: 48px; border: 6px solid transparent; border-bottom: 0; border-top: 7px solid var(--c); }
  #calc .arr.e[data-dir="l"] .ln { left: 22px; right: 48px; }
  #calc .arr.e[data-dir="l"] .ln2 { right: auto; left: 22px; }
  #calc .arr.e[data-dir="l"] .hd { right: auto; left: 18px; }
  #calc .tal { position: relative; width: 48px; height: 48px; padding: 0; border-radius: 4px; cursor: pointer; overflow: visible;
    border: 2px solid var(--line); background: var(--bar-track); color: #fff; font: inherit; touch-action: manipulation; -webkit-user-select: none; user-select: none; }
  #calc .tal img { width: 100%; height: 100%; display: block; border-radius: 2px; }
  #calc .tal .ini { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-display); font-size: 1.1rem; z-index: -0; }
  #calc .tal img + .ini { display: none; }
  #calc .tal b { position: absolute; right: -6px; bottom: -6px; font-size: 0.72rem; line-height: 1; padding: 2px 3px; border-radius: 3px; background: var(--bg); color: var(--muted); border: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  #calc .tal[data-state="locked"] img, #calc .tal[data-state="locked"] .ini { filter: grayscale(1) brightness(0.55); }
  #calc .tal[data-state="open"] { border-color: var(--do); }
  #calc .tal[data-state="open"] b { color: var(--do); }
  #calc .tal[data-state="some"] { border-color: var(--do); }
  #calc .tal[data-state="some"] b { color: var(--do); border-color: var(--do); }
  #calc .tal[data-state="max"] { border-color: var(--quest-bright); }
  #calc .tal[data-state="max"] b { color: var(--quest); border-color: var(--quest-bright); }
  @media (max-width: 999px) { #calc .detail { position: sticky; bottom: 0; z-index: 2; max-height: 42vh; overflow: auto; box-shadow: 0 -6px 16px rgba(0,0,0,.18); } }
  #calc .detail { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--xp); border-radius: var(--radius); padding: 0.8rem 1rem; min-height: 8rem; }
  #calc .detail h3 { margin: 0 0 0.4rem; font-size: var(--step-1); }
  #calc .detail p { margin-bottom: 0.5rem; white-space: pre-line; }
  #calc .detail .est { color: var(--quest); }
  #builds { margin-top: 2rem; border-top: 2px solid var(--ink); padding-top: 0.8rem; }
  #builds h3 { margin: 1.2rem 0 0.2rem; }
  #builds h4 { margin: 0.8rem 0 0.2rem; font-size: 1rem; }
  #builds .builds { list-style: none; padding: 0; margin: 0.3rem 0 0; }
  #builds .builds li { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; align-items: baseline; padding: 0.4rem 0.2rem; border-bottom: 1px solid var(--line); }
  #builds .load { text-decoration: none; }
  #builds .load b { text-decoration: underline; text-decoration-color: var(--xp); text-underline-offset: 3px; }
  #builds .split { color: var(--muted); font-variant-numeric: tabular-nums; margin-left: 0.3rem; }
</style>
