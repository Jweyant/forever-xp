---
import Base from "../layouts/Base.astro";
import { SOURCE_KINDS, CLASSES } from "../scripts/gear/model";
import { ICON } from "../config";
---
<Base image="/og/bis.jpg" title="BIS planner" description="WoW Forever best-in-slot planner: import your character from the game, pick PvE, PvP, leveling or your own stat weights, and see the best item for every slot on an in-game style character sheet.">
  <h1>BIS planner</h1>
  <p class="lede">Your character sheet, with the best item for every slot. Start from the gear you're wearing, pick what you're gearing for, then click any slot to swap it.</p>

  <section id="gear" aria-busy="true">
    <div class="classbar" role="group" aria-label="Class">
      {Object.entries(CLASSES).map(([k, c]) => (
        <button type="button" class="clsbtn" data-pickcls={k} aria-pressed="false" title={c.name}>
          <img src={ICON(`classicon_${k.toLowerCase()}`)} alt="" width="34" height="34" loading="lazy" />
          <span>{c.name}</span>
        </button>
      ))}
    </div>

    <div class="sheet">
      <div class="doll-wrap">
        <div class="doll-head">
          <div class="viewtoggle" role="group" aria-label="Show">
            <button type="button" data-view="plan" aria-pressed="true">BIS plan</button>
            <button type="button" data-view="cur" aria-pressed="false">Current gear</button>
          </div>
          <button type="button" class="btn secondary" id="g-3d-open">View in 3D</button>
          <p class="small hint">Click a slot to change it. Right-click, long-press or press Delete to remove it.</p>
        </div>
        <div id="g-doll" class="paperdoll"><p class="loading">Loading Forever's gear database…</p></div>
        <iframe id="g-3d-frame" title="3D character model" sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer" hidden></iframe>
        <p class="small muted" id="g-3d-note" hidden></p>
        <dl id="g-summary" class="summary"></dl>
      </div>

      <aside class="panel">
        <div class="controls">
          <label>Spec<select id="g-spec"></select></label>
          <label>Gearing for<select id="g-goal"></select></label>
          <label>Faction<select id="g-side"><option value="H">Horde</option><option value="A">Alliance</option></select></label>
          <label>Race<select id="g-race"></select></label>
          <label>Body<select id="g-body"><option value="M">Body 1</option><option value="F">Body 2</option></select></label>
          <label class="lvl">Level <output id="g-level-out">60</output><input type="range" id="g-level" min="10" max="60" step="1" value="60" /></label>
        </div>
        <div class="actions">
          <button type="button" class="btn" id="g-suggest">Suggest best in slot</button>
          <button type="button" class="btn secondary" id="g-keep">Reset plan to current</button>
          <button type="button" class="btn secondary" id="g-copy">Copy plan link</button>
        <div class="save-plan" data-save-plan="bis" hidden>
          <form><label class="sr" for="save-name">Name</label><input id="save-name" maxlength="60" placeholder="Name this plan" autocomplete="off" /><button type="submit" class="btn secondary">Save to my account</button></form>
          <a class="small" data-save-signin hidden>Sign in with Discord to save this plan</a>
        </div>
        </div>
        <details class="sources">
          <summary>Where items can come from</summary>
          <div class="srcgrid">{SOURCE_KINDS.map((s) => <label><input type="checkbox" data-src={s.key} checked /> {s.name}</label>)}</div>
        </details>
        <details class="import">
          <summary><b>Import your character</b> from the game</summary>
          <p class="small">In game, type <code>/fscout gear</code>, press Ctrl+C, then paste below. Needs <a href="/scout/">ForeverScout</a> 0.3 or newer.</p>
          <textarea id="g-import" rows="2" placeholder="FXPG1:WARRIOR:60:Orc.M:H:head=..." aria-label="Gear string from /fscout gear"></textarea>
          <button type="button" class="btn secondary" id="g-import-go">Import gear</button>
        </details>
      </aside>
    </div>

    <section class="statsbox">
      <h2>Character stats</h2>
      <div id="g-stats" class="stats"></div>
    </section>

    <details class="slotlist">
      <summary><b>Slot by slot comparison</b> <span class="muted">current gear against the plan</span></summary>
      <div class="table-scroll">
        <table class="doll">
          <thead><tr><th>Slot</th><th>Current</th><th>Plan</th><th class="num">Gain</th><th></th></tr></thead>
          <tbody id="g-rows"></tbody>
        </table>
      </div>
    </details>
    <details class="slotlist">
      <summary><b>Stat weights</b> <span class="muted">how much each stat is worth to your spec</span></summary>
      <p id="g-weights-note" class="small muted"></p>
      <div id="g-weights" class="weights"></div>
    </details>

    <div id="g-tip" class="wowtip" hidden role="tooltip"></div>
    <dialog id="g-picker">
      <form method="dialog" class="picker-head">
        <h2 id="g-picker-title">Choose an item</h2>
        <button class="btn secondary" value="close">Close</button>
      </form>
      <div class="picker-tools">
        <input type="search" id="g-search" placeholder="Search by name or item ID" aria-label="Search items" />
        <label>Put it in <select id="g-target"><option value="plan">My plan</option><option value="cur">My current gear</option></select></label>
        <label><input type="checkbox" id="g-all" /> Show items I can't use yet</label>
      </div>
      <ul id="g-picker-list" class="picker-list"></ul>
    </dialog>
  </section>

  <h2>How suggestions work</h2>
  <ul>
    <li>Each item's score is its stats multiplied by your stat weights. Weapon DPS counts most in the slot it's built for, and two-handers are compared against your best main hand and off hand together.</li>
    <li>Starting weights are a reasonable baseline for each spec and goal, not a simulation. Pick <b>Custom weights</b> to set your own, and share the link to show your reasoning.</li>
    <li>Set bonuses that give stats count toward your totals once you wear enough pieces. Hit caps aren't factored in yet.</li>
    <li>Quest rewards, vendors, chests and mob drops come from Questie's Forever database. Anything still unknown fills in as players running ForeverScout log loot.</li>
  </ul>
  <p class="small muted">Forever client build <span id="g-build">–</span>. Item sources from <a href="https://github.com/Questie/Questie">Questie</a>'s Forever database (GPLv3), <a href="https://github.com/cmangos/classic-db">cmangos classic-db</a> (GPL-3.0) and <a href="https://github.com/Hoizame/AtlasLootClassic">AtlasLoot Classic</a> (GPL-2.0), plus ForeverScout player logs. Item and character portrait icons are Blizzard's; the character figure is drawn for this site, and the optional 3D view draws the character with <a href="https://www.wowhead.com/">Wowhead</a>'s model viewer.</p>
</Base>
<script>import "../scripts/gear/planner.ts"; import { mountSave } from "../scripts/saveplan"; mountSave();</script>

<style is:global>
  #gear .classbar { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0 1.2rem; }
  #gear .clsbtn { display: flex; align-items: center; gap: 0.45rem; padding: 0.2rem 0.75rem 0.2rem 0.2rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink); font: 600 0.98rem var(--font-display); letter-spacing: 0.02em; cursor: pointer; transition: border-color .12s, background .12s; }
  #gear .clsbtn img { width: 30px; height: 30px; border-radius: 50%; display: block; }
  #gear .clsbtn[aria-pressed="true"] { border-color: var(--xp); background: var(--xp-soft); box-shadow: 0 0 0 1px var(--xp) inset; }
  #gear .clsbtn:hover { border-color: var(--xp); }
  @media (max-width: 719px) { #gear .clsbtn span { display: none; } #gear .clsbtn { padding: 0.2rem; } }

  #gear .sheet { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1.2rem; align-items: start; }
  @media (max-width: 980px) { #gear .sheet { grid-template-columns: 1fr; } }
  .doll-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 1rem; margin-bottom: 0.5rem; }
  .doll-head .hint { margin: 0; color: var(--muted); }
  .viewtoggle { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
  .viewtoggle button { border: 0; background: var(--surface); color: var(--ink); font: 600 0.98rem var(--font-display); padding: 0.4rem 1rem; cursor: pointer; }
  .viewtoggle button[aria-pressed="true"] { background: var(--xp-fill); color: #fff; }

  /* The character sheet: always dark, framed like the in-game window */
  .paperdoll {
    --cls: #c79c6e;
    display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: "u u u" "l f r" "b b b"; gap: 8px 14px;
    padding: 12px 16px 16px; border-radius: 10px; color: var(--panel-ink); min-height: 420px; user-select: none;
    background:
      radial-gradient(ellipse at 50% 38%, #283247 0%, #151a28 58%, #0b0e17 100%);
    border: 2px solid var(--panel-edge); box-shadow: inset 0 0 0 1px #000, inset 0 0 0 4px #1c1a14, inset 0 0 50px rgba(0,0,0,.6), var(--shadow);
  }
  .paperdoll .loading { grid-column: 1 / -1; align-self: center; text-align: center; color: #b5ad99; }
  .paperdoll[data-klass="warrior"] { --cls: #c79c6e; } .paperdoll[data-klass="paladin"] { --cls: #f58cba; }
  .paperdoll[data-klass="hunter"] { --cls: #abd473; } .paperdoll[data-klass="rogue"] { --cls: #fff569; }
  .paperdoll[data-klass="priest"] { --cls: #ffffff; } .paperdoll[data-klass="shaman"] { --cls: #2e8ef0; }
  .paperdoll[data-klass="mage"] { --cls: #69ccf0; } .paperdoll[data-klass="warlock"] { --cls: #9482c9; }
  .paperdoll[data-klass="druid"] { --cls: #ff7d0a; }
  .paperdoll .unit { grid-area: u; display: flex; align-items: center; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid #3a3424; }
  .paperdoll .portrait { position: relative; width: 60px; height: 60px; flex: none; border-radius: 50%; overflow: hidden; border: 2px solid #c9a24a; box-shadow: 0 0 0 2px #000, 0 0 14px color-mix(in srgb, var(--cls) 50%, transparent); background: #000; }
  .paperdoll .portrait img { width: 100%; height: 100%; display: block; }
  .paperdoll .portrait .lvl { position: absolute; right: -2px; bottom: -2px; min-width: 24px; height: 24px; padding: 0 4px; border-radius: 12px; background: #1b1408; border: 2px solid #c9a24a; color: #ffd65a; font: 700 0.8rem/20px var(--font-body); text-align: center; }
  .paperdoll .who { display: grid; flex: 1; font-family: var(--font-display); }
  .paperdoll .who b { font-size: 1.35rem; color: var(--cls); letter-spacing: .02em; text-shadow: 0 1px 2px #000; }
  .paperdoll .who span { font-size: .95rem; color: #c9c1ad; }
  .paperdoll .pow { display: grid; text-align: right; font-family: var(--font-display); }
  .paperdoll .pow span { font-size: .85rem; color: #a59c86; }
  .paperdoll .pow b { font-size: 1.7rem; line-height: 1; color: #e8b92e; }
  .paperdoll .col { display: grid; gap: 6px; align-content: start; padding-top: 4px; }
  .paperdoll .left { grid-area: l; } .paperdoll .right { grid-area: r; }
  .paperdoll .bottom { grid-area: b; display: flex; justify-content: center; gap: 8px; padding-top: 4px; }
  .paperdoll .figure { grid-area: f; display: grid; place-items: center; min-width: 0; }
  .paperdoll .figure-svg { width: min(250px, 100%); height: auto; overflow: visible; }
  /* The figure (scripts/gear/figure.ts) sets its own fills; these add outlines, glow and hover. */
  .figure-svg .skin { stroke: #000; stroke-opacity: .28; stroke-width: .8; }
  .figure-svg .part { stroke: #56627a; stroke-width: 1; stroke-opacity: .55; cursor: pointer; transition: filter .15s, stroke-opacity .15s; }
  .figure-svg .part.eq { stroke: var(--c); stroke-width: 1.3; stroke-opacity: .95; filter: drop-shadow(0 0 2.5px color-mix(in srgb, var(--c) 55%, transparent)); }
  .figure-svg .part.ghost { stroke: none; }
  .figure-svg .part.bowp { fill: none; stroke-width: 4; }
  .figure-svg .string { stroke: #c9c1ad; stroke-width: 1; fill: none; pointer-events: none; }
  .figure-svg .part.eq.hl, .figure-svg .part.eq:hover { filter: brightness(1.3) drop-shadow(0 0 5px var(--c)); }
  .figure-svg .part:not(.eq).hl, .figure-svg .part:not(.eq):hover { stroke: #8fb8ff; stroke-opacity: 1; stroke-dasharray: 3 2; }
  .paperdoll .slot { position: relative; width: 52px; height: 52px; padding: 0; border-radius: 6px; cursor: pointer; overflow: hidden;
    background: linear-gradient(145deg, #1d242f, #0a0d13); border: 2px solid var(--qb, #3b4150);
    box-shadow: inset 0 0 0 1px #000, 0 0 0 1px #000, 0 0 10px color-mix(in srgb, var(--qb, #000) 40%, transparent); transition: transform .08s; }
  .paperdoll .slot:active { transform: scale(.96); }
  .paperdoll .slot img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .paperdoll .slot .glyph { width: 30px; height: 30px; fill: none; stroke: #59627a; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
  .paperdoll .slot.full .glyph { stroke: #7d869c; }
  .paperdoll .slot:hover, .paperdoll .slot:focus-visible, .paperdoll .slot.hl { outline: 2px solid #ffd65a; outline-offset: 1px; }
  .paperdoll .badge { position: absolute; z-index: 1; line-height: 1; }
  .paperdoll .badge.up { right: 3px; top: 3px; width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-bottom: 9px solid #3ee05a; filter: drop-shadow(0 0 1px #000); }
  .paperdoll .badge.own { left: 2px; bottom: 2px; font: 700 .62rem/1 var(--font-body); padding: 2px 3px; border-radius: 3px; background: #e8b92e; color: #111; }
  @media (max-width: 560px) {
    .paperdoll { gap: 6px; padding: 10px; min-height: 0; }
    .paperdoll .slot { width: 42px; height: 42px; }
    .paperdoll .slot .glyph { width: 24px; height: 24px; }
    .paperdoll .col { gap: 4px; }
    .paperdoll .who b { font-size: 1.1rem; } .paperdoll .pow b { font-size: 1.3rem; }
    .paperdoll .portrait { width: 48px; height: 48px; }
  }
  #g-tip { position: fixed; }

  #gear .summary { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; padding-top: 0.7rem; margin: 0.4rem 0 0; }
  #gear .summary dt { color: var(--muted); font-size: var(--step--1); }
  #gear .summary dd { margin: 0; font: 600 var(--step-2) var(--font-display); }
  #gear .summary .xp { color: var(--xp); }
  #gear .up { color: var(--do); } #gear .down { color: var(--skip); }

  #gear .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 1rem; display: grid; gap: 0.9rem; position: sticky; top: 84px; }
  @media (max-width: 980px) { #gear .panel { position: static; } }
  #gear .controls { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 0.8rem; }
  #gear .controls label { display: grid; gap: 0.2rem; font-size: var(--step--1); color: var(--muted); }
  #gear .controls .lvl { grid-column: 1 / -1; }
  #gear .controls output { color: var(--ink); font-weight: 700; }
  #gear input[type="range"] { accent-color: var(--xp); width: 100%; }
  #gear .actions { display: grid; gap: 0.5rem; }
  #gear .actions .btn { justify-content: center; width: 100%; }
  #gear .panel details { border-top: 1px solid var(--line); padding-top: 0.7rem; }
  #gear .panel summary { cursor: pointer; font-weight: 600; }
  #gear .srcgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem 0.6rem; margin-top: 0.5rem; font-size: 0.92rem; }
  #gear .srcgrid input, #gear .own input { accent-color: var(--xp); }
  #gear .import p { margin: 0.5rem 0; }
  #gear .import textarea { width: 100%; font: 0.85rem ui-monospace, Consolas, monospace; margin-bottom: 0.5rem; }

  #gear .statsbox h2 { font-size: var(--step-2); margin-top: 1.6rem; }
  #gear .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.8rem; }
  #gear .stats section { background: var(--panel); color: var(--panel-ink); border: 1px solid #3a3424; border-radius: 8px; padding: 0.6rem 0.8rem; }
  #gear .stats h3 { margin: 0 0 0.4rem; font-size: 1.1rem; color: #ffd65a; }
  #gear .stats dl { margin: 0; display: grid; gap: 0.15rem; }
  #gear .stats dl div { display: flex; justify-content: space-between; gap: 0.6rem; font-size: 0.93rem; }
  #gear .stats dt { color: #c9c1ad; } #gear .stats dd { margin: 0; font-weight: 600; }
  #gear .stats .wanted dt { color: #fff; }
  #gear .stats small { color: #a59c86; font-weight: 400; }
  #gear .stats .up { color: #3ee05a; } #gear .stats .down { color: #ff7b7b; }

  #gear .slotlist { margin: 1.2rem 0; }
  #gear .slotlist summary { cursor: pointer; margin-bottom: .6rem; }
  #gear .doll th[scope="row"] { white-space: nowrap; color: var(--muted); font-weight: 600; position: static; background: none; }
  #gear .doll td.item { min-width: 14rem; }
  #gear .doll .meta { display: block; font-size: 0.82rem; color: var(--muted); font-weight: 400; }
  #gear .acts { white-space: nowrap; }
  #gear .acts .own { display: block; font-size: 0.85rem; margin-top: 0.3rem; }
  @media (max-width: 719px) {
    #gear .doll thead { display: none; }
    #gear .doll, #gear .doll tbody, #gear .doll tr, #gear .doll td, #gear .doll th[scope="row"] { display: block; }
    #gear .doll tr { padding: 0.7rem 0.8rem; border-bottom: 1px solid var(--line); }
    #gear .doll td, #gear .doll th[scope="row"] { border: 0; padding: 0.15rem 0; text-align: left; }
    #gear .doll td.item::before, #gear .doll td.num::before { content: attr(data-label); display: block; font-size: 0.75rem; color: var(--muted); }
    #gear .doll td.num::before { display: inline; margin-right: 0.4rem; }
  }
  .link { background: none; border: 0; padding: 0; color: var(--rested); font: inherit; text-decoration: underline; cursor: pointer; }
  #gear .weights { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 0.4rem 0.8rem; }
  #gear .weights label { display: flex; justify-content: space-between; align-items: center; gap: 0.4rem; font-size: 0.9rem; }
  #gear .weights input { width: 5.2rem; }
  #gear .weights input:disabled { opacity: 0.7; }

  #g-picker { width: min(760px, calc(100vw - 24px)); max-height: 86vh; border: 1px solid var(--line); border-radius: 10px; background: var(--raise); color: var(--ink); padding: 1rem; box-shadow: 0 20px 60px rgba(0,0,0,.35); }
  #g-picker::backdrop { background: rgba(10, 12, 24, 0.6); }
  #g-picker .picker-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  #g-picker .picker-head h2 { margin: 0; font-size: var(--step-2); }
  /* The 3D view sits over the drawn figure in the character sheet (scripts/gear/viewer3d.ts
     keeps it aligned); it lives outside #g-doll so re-renders don't reload the iframe. */
  #gear .doll-wrap { position: relative; }
  #g-3d-frame { position: absolute; border: 0; border-radius: 8px; background: #0d0f16; }
  .mode3d .paperdoll .figure { visibility: hidden; }
  #g-3d-open[aria-pressed="true"] { border-color: var(--rested, #8fb8ff); color: var(--rested, #8fb8ff); }
  #g-picker .picker-tools { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; margin: 0.8rem 0; }
  #g-picker .picker-tools input[type="search"] { flex: 1 1 220px; }
  #g-picker .picker-list { list-style: none; padding: 0; margin: 0; max-width: none; }
  #g-picker .picker-list li + li { border-top: 1px solid var(--line); }
  #g-picker .picker-list button[data-choose]:not(.link) { all: unset; box-sizing: border-box; display: grid; grid-template-columns: 44px 1fr auto; gap: 0.7rem; align-items: center; width: 100%; padding: 0.5rem 0.4rem; cursor: pointer; border-radius: 6px; }
  #g-picker .picker-list button[data-choose]:hover, #g-picker .picker-list button[data-choose]:focus-visible { background: var(--surface); outline: 2px solid var(--focus); }
  #g-picker .picker-list button.on { background: var(--xp-soft); }
  #g-picker .pn { display: grid; min-width: 0; }
  #g-picker .pn .iname-t { font-weight: 600; }
  #g-picker .meta { font-size: 0.82rem; color: var(--muted); }
  #g-picker .score { display: grid; text-align: right; font: 700 1.15rem var(--font-display); color: var(--xp); }
  #g-picker .score small { font: 600 0.8rem var(--font-body); color: var(--muted); }
  #g-picker .score small.up { color: var(--do); } #g-picker .score small.down { color: var(--skip); }
  #g-picker .picker-list .link { margin: 0.5rem 0.3rem; }
</style>
