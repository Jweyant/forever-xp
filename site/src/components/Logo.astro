---
// The Forever XP mark: an infinity loop drawn as the in-game experience bar.
// Purple is earned XP, blue is rested XP, the gold spark is the next level coming up,
// and the 20 notches are the bar's segments.
interface Props { size?: number; animate?: boolean; title?: string }
const { size = 36, animate = false, title } = Astro.props;
const D = "M24 24 C28 17 33 14.5 37.5 14.5 C42 14.5 44 19 44 24 C44 29 42 33.5 37.5 33.5 C33 33.5 28 31 24 24 C20 17 15 14.5 10.5 14.5 C6 14.5 4 19 4 24 C4 29 6 33.5 10.5 33.5 C15 33.5 20 31 24 24 Z";
---
<svg class:list={["logo-mark", { animate }]} viewBox="2 10 44 28" width={size} height={Math.round(size * 28 / 44)}
     role={title ? "img" : undefined} aria-hidden={title ? undefined : "true"} aria-label={title}>
  <path d={D} fill="none" stroke="var(--logo-edge, #0c0f1c)" stroke-width="8.6" stroke-linejoin="round" />
  <path d={D} fill="none" stroke="var(--logo-track, #262b45)" stroke-width="6" stroke-linejoin="round" />
  <path class="fill" d={D} pathLength="100" fill="none" stroke="var(--logo-xp, #8b5ce0)" stroke-width="6" stroke-dasharray="62 38" />
  <path class="rest" d={D} pathLength="100" fill="none" stroke="var(--logo-rested, #4f8ee6)" stroke-width="6" stroke-dasharray="0 62 12 26" />
  <path d={D} pathLength="100" fill="none" stroke="var(--logo-edge, #0c0f1c)" stroke-width="6.2" stroke-dasharray="0 4.65 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 9.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.3 0.7 4.65" opacity=".85" />
  <path d={D} pathLength="100" fill="none" stroke="var(--logo-edge, #0c0f1c)" stroke-width="8.6" stroke-dasharray="0 46 8 46" />
  <path class="fill" d={D} pathLength="100" fill="none" stroke="var(--logo-xp, #8b5ce0)" stroke-width="6" stroke-dasharray="0 45.6 8.8 45.6" />
  <circle class="spark" cx="13.3" cy="14.83" r="2.4" fill="#ffe08a" />
  <circle class="spark" cx="13.3" cy="14.83" r="4.2" fill="#ffd34d" opacity=".28" />
</svg>
