---
// One row per change, as on /changes/. The data-* attributes feed that page's filters; other
// pages just show the list.
import { ICON } from "../config";
import { fmt, type Row } from "../lib/changes";
interface Props { rows: Row[]; build: string; id?: string }
const { rows, build, id } = Astro.props;
---
<ol class="rows" id={id}>
  {rows.map((r) => (
    <li data-src={r.kind} data-area={r.area} data-cls={r.cls || ""} data-race={r.race || ""} data-date={r.date} data-dev={r.note?.length || r.dev ? "1" : ""}
        data-search={`${r.text} ${(r.detail || []).join(" ")} ${(r.note || []).join(" ")} ${r.path.join(" ")} ${r.area}`.toLowerCase()}>
      <div class="meta">
        <span class={`src ${r.kind === "Datamined" ? "mined" : r.kind === "Known issue" ? "issue" : "blz"}`}>{r.kind === "Blizzard" ? "Blizzard" : r.kind === "Datamined" ? "Client" : "Known issue"}</span>
        {r.date && <time datetime={r.date}>{fmt(r.date)}</time>}
      </div>
      <div class="body">
        <p class="where">
          {r.cls && <img src={ICON(`classicon_${r.cls.toLowerCase()}`, 18)} alt="" width="16" height="16" loading="lazy" />}
          {[r.area, ...r.path].filter(Boolean).join(" › ")}
          {r.chips?.map((c) => <span class="chip">{c}</span>)}
        </p>
        <p class={r.dev ? "txt devtxt" : "txt"}>{r.dev && <b>Developers' notes: </b>}{r.text}</p>
        {r.detail && <ul class="detail">{r.detail.map((d) => <li>{d}</li>)}</ul>}
        {r.note && r.note.map((d) => <p class="dev"><b>Developers' notes:</b> {d}</p>)}
      </div>
      {r.url ? <a class="post" href={r.url} rel="noopener" title="Read Blizzard's original post">Source</a> : <span class="post muted" title={`Forever client build ${build}`}>Build {build.split(".").pop()}</span>}
    </li>
  ))}
</ol>
<style>
  .rows { list-style: none; padding: 0; margin: 0; max-width: none; border-top: 1px solid var(--line); }
  .rows > li { display: grid; grid-template-columns: 6.5rem 1fr auto; gap: 0.3rem 1rem; padding: 0.7rem 0.2rem; border-bottom: 1px solid var(--line); }
  .rows > li[hidden] { display: none; }
  .meta { display: grid; align-content: start; gap: 0.2rem; font-size: 0.85rem; color: var(--muted); }
  .src { justify-self: start; font: 600 0.72rem/1 var(--font-body); padding: 0.25em 0.5em; border-radius: 3px; }
  .src.blz { background: #0f4c9c; color: #fff; } .src.mined { background: var(--xp-soft); color: var(--xp); } .src.issue { background: var(--skip-soft); color: var(--skip); }
  .body p { margin: 0; max-width: 80ch; }
  .where { font-size: 0.85rem; color: var(--muted); display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .where img { border-radius: 50%; }
  .chip { font-size: 0.72rem; font-weight: 600; padding: 0.05em 0.45em; border: 1px solid var(--line); border-radius: 3px; color: var(--ink); }
  .txt { margin-top: 0.1rem !important; }
  .devtxt, .dev { font-style: italic; color: var(--muted); }
  .dev { margin-top: 0.3rem !important; border-left: 3px solid var(--quest-bright); padding-left: 0.6rem; font-size: 0.95rem; }
  .detail { margin: 0.3rem 0 0; padding-left: 1.1rem; font-size: 0.95rem; }
  .post { font-size: 0.85rem; white-space: nowrap; align-self: start; }
  @media (max-width: 640px) {
    .rows > li { grid-template-columns: 1fr auto; }
    .meta { grid-column: 1 / -1; display: flex; gap: 0.6rem; align-items: center; }
    .body { grid-column: 1; }
  }
</style>
